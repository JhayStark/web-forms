# API Configuration
# Set this to your API base URL in production
# VITE_API_BASE_URL=https://your-api.com/api

# Mock API (Optional - Fallback only)
# This is now optional and mainly used as a fallback when no API URL is provided
# Individual components can override this by passing the useMockApi prop
# Example forms (/src/components/examples/FormExample.tsx) use useMockApi={true} prop
# Production forms (/src/pages/FormPage.tsx) use useMockApi={false} (default)
# VITE_USE_MOCK_API=true

# Google Maps API Key
# Required for polygon/map features
# Get your API key from: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_API_BASE_URL=http://replace_with_insyt_api/v1
